{% block block_ez_before_after_slider %}
    {% set element = block.slots.getSlot('content') %}
    {% if element %}
        <div class="col-12" data-cms-element-id="{{ element.id }}">
            {% block block_ez_before_after_slider_inner %}
                {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' ignore missing with {
                    element: element
                } %}
            {% endblock %}
        </div>
    {% endif %}
{% endblock %}
