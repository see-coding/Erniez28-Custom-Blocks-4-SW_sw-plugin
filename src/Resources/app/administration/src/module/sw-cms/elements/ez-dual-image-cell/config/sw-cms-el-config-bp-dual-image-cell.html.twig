<div class="sw-cms-el-config-bp-dual-image-cell">

    <!-- Bild-Auswahl -->
    <div class="sw-cms-el-config-bp-dual-image-cell__media-section">
        <sw-cms-mapping-field
            v-model:config="element.config.media"
            label="Bild"
            valueTypes="entity"
            entity="media"
            class="sw-cms-el-config-bp-dual-image-cell__media-field">

            <sw-media-compact-upload-v2
                variant="regular"
                label="Bild auswählen"
                :source="element.config.media.value"
                :allowMultiSelect="false"
                :uploadTag="uploadTag"
                :defaultFolder="cmsPageState.defaultMediaFolderId"
                @selection-change="onMediaUpload"
                @media-upload-remove-image="onMediaRemove">
            </sw-media-compact-upload-v2>

        </sw-cms-mapping-field>
    </div>

    <!-- Alt-Text -->
    <div class="sw-cms-el-config-bp-dual-image-cell__alt-section" style="margin-top: 16px;">
        <mt-text-field
            label="Alt-Text (optional)"
            v-model="element.config.altText.value"
            placeholder="Bildbeschreibung für Barrierefreiheit"
            @change="emitUpdate"
        />
    </div>

    <!-- Link-Feld -->
    <div class="sw-cms-el-config-bp-dual-image-cell__url-section" style="margin-top: 16px;">
        <label style="display:block; margin-bottom: 4px; font-weight: 600; font-size: 14px;">
            Link (optional)
        </label>
        <sw-dynamic-url-field
            v-model:value="element.config.url.value"
            @update:value="emitUpdate"
        />
        <mt-checkbox
            v-model="element.config.newTab.value"
            label="In neuem Tab öffnen"
            style="margin-top: 8px;"
            @change="emitUpdate"
        />
    </div>

</div>
